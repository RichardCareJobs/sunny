# ═══════════════════════════════════════════════════════════════════════════
# Sunny for Venues — environment variables
#
# NOTHING IN THIS FILE IS A REAL KEY, and no real key is ever committed.
#
# Two different places take configuration, and it matters which is which:
#
#   FRONTEND  venues/config.js — served to the browser, committed on purpose.
#             Only the Supabase URL and anon key live there. The anon key is
#             public by design (the consumer app ships the same one); row level
#             security is what protects the data, not the key.
#
#   EDGE      Supabase Edge Function secrets. Everything below lives here and
#             nowhere else. Set with:
#                 supabase secrets set NAME=value
#             or Dashboard → Edge Functions → Secrets.
#
# The phase column tells you when you actually need each one, so account setup
# can happen just ahead of the phase that needs it rather than all at once.
# ═══════════════════════════════════════════════════════════════════════════

# ── Phase 1 · Foundations ────────────────────────────────────────────────────
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY into deployed Edge
# Functions automatically. Set them by hand only for `supabase functions serve`.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                      # NEVER in the repo, never in a browser
DEPLOY_STAGE=development                        # development | staging | production

# ── Phase 3 · Claiming and phone verification ────────────────────────────────
VOICE_PROVIDER=stub                             # stub | twilio
# Needed only when VOICE_PROVIDER=twilio.
# LEAD TIME: WEEKS. An Irish (+353) number needs a regulatory address bundle
# with proof of an Irish address, and approval is slow. Start this in Phase 1.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                             # +353… — a foreign caller ID gets hung up on

# ── Phase 5 · Billing ────────────────────────────────────────────────────────
PAYMENTS_PROVIDER=stub                          # stub | stripe
# Needed only when PAYMENTS_PROVIDER=stripe.
# LEAD TIME: DAYS. Business verification and bank details. Start in Phase 4.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                          # from `stripe listen` or the dashboard endpoint
STRIPE_PUBLISHABLE_KEY=                         # this one is public and goes in config.js

# ── Guard ────────────────────────────────────────────────────────────────────
# With DEPLOY_STAGE=production, any provider still set to "stub" makes the Edge
# Functions refuse to start. The voice stub returns the verification code in its
# response, so a stub in production is a full authentication bypass. Failing to
# boot is the correct behaviour.
